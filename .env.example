NODE_ENV=production
PORT=3000
APP_TIMEZONE=America/Argentina/Buenos_Aires
SESSION_SECRET=generate-a-long-random-value

DB_HOST=localhost
DB_PORT=3306
DB_USER=hostinger_database_user
DB_PASSWORD=hostinger_database_password
