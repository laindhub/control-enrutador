<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#111722"><meta name="csrf-token" content="<%= csrfToken %>"><title>Mis ventas · Más Dueños</title><link rel="icon" href="<%= assetUrl('assets/favicon.png') %>"><link rel="manifest" href="/presentador.webmanifest"><link rel="stylesheet" href="<%= assetUrl('css/presenter.css') %>"></head>
<body><header class="top"><a href="/presentador" class="brand"><img src="<%= assetUrl('assets/mas-duenos-logo.png') %>" alt="Más Dueños"><span>Mis ventas<small>Presentadores · Liniers</small></span></a><div class="identity"><span><%= user.username %></span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="quiet" type="submit">Salir</button></form></div></header>
<main class="shell"><div id="notice" role="status" hidden></div><section class="intro"><div><p class="eyebrow">TU TRABAJO, EN NÚMEROS</p><h1>Todo lo que vendiste.<br><span>Todo lo que te corresponde.</span></h1><p class="muted">Registrá tus anuncios y llevá el control de lo que cobrás.</p></div><button class="primary" id="new-sale">＋ Registrar venta</button></section>
<nav class="tabs" aria-label="Panel de ventas"><button data-tab="sales" class="selected">Ventas</button><button data-tab="folders">Carpetas</button><button data-tab="payments">Pagos</button><% if(user.role==='presenter_admin'){ %><button data-tab="admin">Administración</button><% } %></nav>
<section id="panel-sales"><div class="section-head"><h2>Tu resumen mensual</h2><label class="month-label">Mes <input type="month" id="month"></label></div><div id="metrics" class="metrics"></div><div class="section-head"><h2>Ventas registradas</h2><button class="quiet" id="refresh">Actualizar</button></div><div id="sales-list" class="cards"><p class="muted">Cargando tus ventas…</p></div></section>
<section id="panel-folders" hidden><div class="section-head"><h2>Carpetas semanales</h2><span class="muted">Jueves → miércoles</span></div><p class="muted">Cada carpeta se paga el jueves o viernes de la semana siguiente al cierre.</p><div id="folders-list" class="cards"></div></section>
<section id="panel-payments" hidden><div class="section-head"><h2>Transferencias recibidas</h2><button id="new-payment" class="primary">＋ Registrar pago</button></div><div id="payments-list" class="cards"></div></section>
<% if(user.role==='presenter_admin'){ %><section id="panel-admin" hidden><h2>Administración</h2><div class="admin-grid"><article class="card"><h3>Comisión común</h3><p class="muted">El valor se aplica a las nuevas cargas según la fecha del anuncio. Las ventas guardadas conservan su comisión.</p><form id="rate-form"><label>Importe por venta<input name="amount" type="number" min="0" step="1" required></label><label>Aplicar desde<input name="date" type="date" required></label><button class="primary">Guardar comisión</button></form><div id="rates-list"></div></article><article class="card"><h3>Crear presentador</h3><form id="user-form"><label>Usuario<input name="username" minlength="3" maxlength="80" autocomplete="off" required></label><label>Contraseña inicial (opcional)<input name="password" type="password" maxlength="72" autocomplete="new-password"></label><p class="muted">Cada cuenta ve únicamente sus ventas y pagos.</p><button class="primary">Crear cuenta</button></form><div id="users-list"></div></article></div><article class="card" id="sync-status"></article></section><% } %>
<footer>Más Dueños · Control personal de comisiones</footer></main>
<dialog id="sale-dialog"><div class="dialog-head"><div><p class="eyebrow">NUEVA VENTA</p><h2 id="sale-title">Del anuncio a tu cuenta</h2></div><button class="close" data-close="sale-dialog" aria-label="Cerrar">×</button></div><form id="sale-form"><input type="hidden" name="id"><label>Fecha del anuncio<input type="date" name="date" required></label><label>Mensaje de WhatsApp<textarea name="rawText" rows="5" maxlength="12000" placeholder="Pegá acá el anuncio de la venta"></textarea></label><button type="button" id="extract" class="secondary">Leer mensaje con IA</button><p class="muted">Revisá los datos antes de guardar. También podés completarlos manualmente.</p><div class="form-grid"><label>Cliente<input name="clientName" maxlength="255"></label><label>Teléfono<input name="phone" type="tel" maxlength="40"></label><label>Asesor/a<input name="advisor" maxlength="255"></label><label>Charla de<input name="presenter" maxlength="255"></label><label>Cuota del cliente · ARS<input name="quota" type="number" min="0" step="1"></label></div><label>Observaciones<textarea name="notes" rows="2" maxlength="2000"></textarea></label><label>Vincular visita<select name="visitId"><option value="">Sin visita vinculada</option></select></label><button type="button" id="find-lead" class="quiet">Buscar por teléfono en leads sincronizados</button><p id="sale-estimate" class="estimate"></p><p id="sale-error" class="form-error" role="alert"></p><button class="primary full" type="submit">Guardar venta</button></form></dialog>
<dialog id="payment-dialog"><div class="dialog-head"><h2>Registrar transferencia</h2><button class="close" data-close="payment-dialog" aria-label="Cerrar">×</button></div><form id="payment-form"><label>Carpeta semanal<select name="folderStart" required></select></label><label>Fecha de transferencia<input name="date" type="date" required></label><label>Importe recibido · ARS<input name="amount" type="number" min="1" step="1" required></label><label>Nota o referencia<input name="notes" maxlength="1000"></label><p id="payment-error" class="form-error" role="alert"></p><button class="primary full">Guardar pago</button></form></dialog>
<dialog id="confirm-dialog"><div class="dialog-head"><h2>Eliminar registro</h2><button class="close" data-close="confirm-dialog" aria-label="Cerrar">×</button></div><p>Se quitará del cálculo de tu cuenta. El registro quedará conservado en la base.</p><button id="confirm-delete" class="danger full">Eliminar</button></dialog>
<script src="<%= assetUrl('js/presenter.js') %>" defer></script></body></html>
