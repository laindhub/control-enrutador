<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#15191f">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/styles.css?v=20260831-footer-fix">
  </head>
  <body class="router-page">
    <header class="topbar">
      <div class="topbar-inner">
        <img src="/assets/assets/mas-duenos-logo.svg" alt="Más Dueños" class="topbar-logo">
        <div class="operator-pill">Operando como: <strong><%= operator.name %></strong></div>
        <button id="changeOperator" class="text-button" type="button">Cambiar</button>
      </div>
    </header>
    <main class="page-shell router-shell">
      <section class="page-heading">
        <div><p class="eyebrow">LINIERS · TIEMPO REAL</p><h1>Control de atenciones</h1></div>
        <button id="editToggle" class="button button-secondary" type="button">Editar</button>
      </section>

      <div id="connectionStatus" class="connection-status" hidden>Reconectando…</div>
      <section id="priorityBanner" class="priority-banner" hidden></section>

      <section class="legend" aria-label="Referencia de equilibrio">
        <span><i class="dot dot-green"></i>Equilibrado</span>
        <span><i class="dot dot-yellow"></i>1 menos</span>
        <span><i class="dot dot-red"></i>2 o más</span>
      </section>

      <section id="advisorGrid" class="advisor-grid" aria-live="polite"></section>
      <section id="emptyState" class="empty-state" hidden>
        <h2>No hay asesores en horario</h2>
        <p>Los asesores aparecerán automáticamente al comenzar su jornada.</p>
      </section>
    </main>

    <footer class="router-footer">
      <div class="router-footer-inner">
        <div class="footer-identity">
          <span class="footer-mark" aria-hidden="true">M</span>
          <div>
            <strong>Más Dueños</strong>
            <span>Control Enrutador · Liniers</span>
          </div>
        </div>
        <form method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="footer-logout" type="submit">
            <span class="footer-logout-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false"><path d="M10 5H5v14h5M14 8l4 4-4 4M18 12H9"/></svg>
            </span>
            <span><strong>Cerrar sesión</strong><small>Finalizar operación</small></span>
          </button>
        </form>
      </div>
    </footer>

    <div id="confirmModal" class="modal-backdrop" hidden>
      <section class="confirm-modal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div class="modal-accent"></div>
        <h2 id="confirmTitle">Confirmar acción</h2>
        <p id="confirmMessage"></p>
        <div class="modal-actions">
          <button id="confirmCancel" class="button button-secondary" type="button">Cancelar</button>
          <button id="confirmAccept" class="button button-primary" type="button">Confirmar</button>
        </div>
      </section>
    </div>
    <div id="toast" class="toast" hidden></div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/assets/js/app.js?v=20260831-router-fix" type="module"></script>
  </body>
</html>
