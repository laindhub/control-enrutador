DB_SSL=false

# Se usan solamente en el primer inicio para crear las cuentas iniciales.
ROUTER_USERNAME=replace-me
ROUTER_PASSWORD=replace-me
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-me
