<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#15191f">
    <title><%= title %> · Salón Más Dueños</title>
    <link rel="icon" type="image/svg+xml" href="<%= assetUrl('assets/favicon-red.svg') %>">
    <link rel="apple-touch-icon" href="<%= assetUrl('assets/favicon-red.svg') %>">
    <link rel="stylesheet" href="<%= assetUrl('css/styles.css') %>">
  </head>
  <body class="auth-page">
    <main class="auth-shell">
      <section class="auth-card">
        <div class="brand-panel">
          <img src="<%= assetUrl('assets/mas-duenos-logo.png') %>" alt="Más Dueños" class="brand-logo">
          <span class="branch-label">Sucursal Liniers</span>
        </div>
        <div class="auth-content">
          <p class="eyebrow">USO INTERNO</p>
          <h1>Salón Más Dueños</h1>
          <p class="muted">Ingresá con la cuenta correspondiente.</p>
          <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
          <form method="post" action="/login" class="stack-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="_backup_csrf" value="<%= respaldoLoginCsrf || '' %>">
            <label>Usuario<input name="username" autocomplete="username" required></label>
            <label>Contraseña<input type="password" name="password" autocomplete="current-password"></label>
            <button class="button button-primary button-block" type="submit">Ingresar</button>
          </form>
          <a class="presentation-login-link" href="/respaldo" aria-label="Entrar al sistema de respaldo del salón">▣ Entrar al sistema de respaldo <span aria-hidden="true">↗</span></a>
          <a class="presentation-login-link" href="/presentacion">▣ Abrir presentaciones del salón <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>
  </body>
</html>
