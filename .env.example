NODE_ENV=production
PORT=3000
APP_TIMEZONE=America/Argentina/Buenos_Aires
SESSION_SECRET=generate-a-long-random-value

DB_HOST=localhost
DB_PORT=3306
DB_USER=hostinger_database_user
DB_PASSWORD=hostinger_database_password
DB_NAME=hostinger_database_name
DB_SSL=false

# Se usan solamente en el primer inicio para crear las cuentas iniciales.
ROUTER_USERNAME=replace-me
ROUTER_PASSWORD=replace-me
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-me

# Opcionales. Si DEMO_USERNAME o DEMO_PASSWORD faltan, la demo no existe para el login.
DEMO_USERNAME=
DEMO_PASSWORD=

# Preparadas para la futura activación productiva del circuito alfa.
ALPHA_PRODUCTION_ENABLED=false
ADVISOR_USERNAME=
ADVISOR_PASSWORD=

# Seguimiento. La pantalla funciona con respuestas simuladas si no se configura la clave.
# Cotización de referencia usada solo para calcular el avance ficticio del plan.
WELCOME_USD_REFERENCE_ARS=1530
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Sincronización externa opcional. Activar únicamente después de probar Chromium.
LEAD_SYNC_ENABLED=false
LEAD_SYNC_ACCOUNT_NAME=
LEAD_SYNC_PIN=
LEAD_SYNC_INTERVAL_MINUTES=15
LEAD_SYNC_DETAIL_BATCH=30
LEAD_SYNC_DETAIL_REFRESH_MINUTES=60
# Ruta opcional al ejecutable Chromium ya instalado en el servidor.
LEAD_SYNC_CHROMIUM_PATH=

# Cuenta propia: presentador con administración de cuentas y comisión común.
# Usar un usuario diferente del administrador del enrutador.
PRESENTER_ADMIN_USERNAME=
PRESENTER_ADMIN_PASSWORD=

# Respaldo operativo independiente en /respaldo (MISMA app Node; OTRA base MySQL).
# Solo ADMINISTRACION usa RESPALDO_USERNAME/PASSWORD; el resto tiene cuentas
# y PIN propios creados en el panel de administración de Respaldo.
# No reutilizar la base DB_NAME ni el usuario ADMIN_USERNAME del sitio existente.
RESPALDO_USERNAME=
RESPALDO_PASSWORD=
RESPALDO_DB_HOST=localhost
RESPALDO_DB_PORT=3306
RESPALDO_DB_USER=
RESPALDO_DB_PASSWORD=
RESPALDO_DB_NAME=
RESPALDO_DB_SSL=false
